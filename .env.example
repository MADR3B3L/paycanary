# Copy to .env (gitignored) and fill in. SANDBOX credentials only.
# Get them: PayPal Developer Dashboard -> Apps & Credentials -> Sandbox -> your app.
# PayPal slot (read ONLY by the PayPal provider). The un-prefixed PAYPAL_* names are deprecated aliases and still work.
PAYCANARY_PAYPAL_ENV=sandbox
PAYCANARY_PAYPAL_CLIENT_ID=
PAYCANARY_PAYPAL_CLIENT_SECRET=
PAYCANARY_PAYPAL_WEBHOOK_ID=
# A sandbox PERSONAL account email to receive test payouts (Dashboard -> Sandbox -> Accounts)
PAYOUT_RECIPIENT_EMAIL=
# Optional: the narrator (Claude Haiku). Leave empty to run with raw narration.
ANTHROPIC_API_KEY=

# Operator controls (all optional; the demo runs without any of them).
# PAYCANARY_PLATFORM_CAP=5000      # hard per-payment ceiling in USD. No agent, profile or manual release can move more than this. Enforced even in shadow mode.
# PAYCANARY_MODE=enforce           # enforce (hold on freeze) or shadow (log what it WOULD freeze, but let it through). Per-agent overrides this.
# PAYCANARY_ENRICHMENT=1           # turn on public lookups on a payee's domain (age, mail records, phishing feeds). Only the domain leaves the machine.
# PAYCANARY_FX_JSON={"EUR":1.08}   # override the coarse static USD rate table (app/fx.py) per currency. NOT live FX; never used to move money.

# Advanced paths and budgets (all optional; sensible defaults shown).
# PAYCANARY_DB=./paycanary.sqlite3                 # where the main database lives.
# PAYCANARY_REPUTATION_DB=./paycanary_reputation.sqlite3   # where the (de-identified) cross-agent reputation store lives.
# PAYCANARY_LOCAL_EVIDENCE=1                        # 1 = allow local offline evidence checks; set 0 to turn them off.
# LLM_MAX_CALLS_PER_DAY=200                         # daily cap on Haiku narration calls (cost guard).
# LLM_MAX_TOKENS_PER_DAY=60000                      # daily cap on Haiku narration tokens (cost guard).

# Stripe slot (read ONLY by the Stripe provider). TEST-MODE keys only: sk_test_... or rk_test_...; a live key makes the app refuse to start.
# PAYCANARY_STRIPE_SECRET_KEY=
# PAYCANARY_STRIPE_WEBHOOK_SECRET=
# PAYCANARY_STRIPE_ACCOUNTS_FILE=.stripe_test_accounts.json

# Audit log tamper-evidence (optional overrides). Default: a random key is created once at ~/.paycanary/audit.key (0600) and anchors go under ~/.paycanary/anchors/.
# PAYCANARY_AUDIT_KEY=            # >=16 chars; best held in a secret manager, not on disk next to the DB
# PAYCANARY_AUDIT_KEY_FILE=
# PAYCANARY_AUDIT_ANCHOR=         # ship these lines to storage the PayCanary host cannot rewrite for the strongest guarantee
